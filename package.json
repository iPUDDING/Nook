{
  "name": "nook",
  "version": "0.14.0",
  "private": true,
  "description": "Workspace tipo Notion: editor de bloques, bases de datos, sidebar de paginas. Next.js + Tailwind.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "capturas": "node scripts/capturas.mjs",
    "verificar": "tsc --noEmit && next build",
    "build:static": "node scripts/export-static.mjs",
    "preview:static": "npx --yes serve out"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.30",
    "playwright": "^1.65.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "author": "Nook contributors",
  "keywords": [
    "notion",
    "notion-clone",
    "notes",
    "block-editor",
    "electron",
    "nextjs",
    "typescript",
    "text-to-speech",
    "productivity",
    "pkm"
  ],
  "homepage": "https://github.com/OWNER/REPO#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/REPO.git"
  }
}
