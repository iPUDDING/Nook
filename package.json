{
  "name": "nook",
  "version": "0.2.1",
  "private": true,
  "description": "Workspace tipo Notion: editor de bloques, bases de datos, sidebar de paginas. Next.js + Tailwind.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "capturas": "node scripts/capturas.mjs",
    "verificar": "tsc --noEmit && next build",
    "build:static": "node scripts/export-static.mjs",
    "preview:static": "npx --yes serve out"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.65.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
